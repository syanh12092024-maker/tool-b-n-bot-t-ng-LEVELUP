# systemd unit cho webhook (nếu không dùng pm2)
#   sudo cp deploy/banbot-webhook.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now banbot-webhook
[Unit]
Description=Bắn bot TALPHA v2 — webhook
After=network.target postgresql.service

[Service]
Type=simple
User=banbot
WorkingDirectory=/opt/banbot
EnvironmentFile=/opt/banbot/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/jobs/webhook.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
