{
  "name": "banbot-talpha-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Hệ thống nuôi dưỡng khách qua Messenger — đồng bộ tệp khách hằng đêm, mỗi khách một hành trình 7 ngày",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "job:sync": "tsx src/jobs/sync.ts",
    "job:plan": "tsx src/jobs/plan.ts",
    "job:send": "tsx src/jobs/send.ts",
    "job:health": "tsx src/jobs/health.ts",
    "job:webhook": "tsx src/jobs/webhook.ts",
    "check:tokens": "tsx src/scripts/check-tokens.ts",
    "check:db": "tsx src/scripts/check-db.ts",
    "page:add": "tsx src/scripts/add-page.ts",
    "page:list": "tsx src/scripts/list-pages.ts",
    "script:seed": "tsx src/scripts/seed-script.ts",
    "db:dev": "tsx src/scripts/dev-db.ts",
    "test:smoke": "tsx src/scripts/smoke-test.ts",
    "job:pos": "tsx src/jobs/pos.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
