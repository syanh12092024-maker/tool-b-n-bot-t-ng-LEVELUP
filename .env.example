# ─── Secrets (KHÔNG commit file .env thật) ───────────────────────────────────
# Copy file này → .env.local rồi điền giá trị thật.
# Code đọc env này và ưu tiên ghi đè lên giá trị trong config/script-generator.yaml.

# Facebook Graph API
FB_USER_ACCESS_TOKEN=
FB_APP_SECRET=

# Pancake CRM
PANCAKE_CRM_TOKEN=

# Google Cloud credentials (chọn 1 trong các cách)
# GOOGLE_CREDENTIALS_BASE64=
# GOOGLE_CREDENTIALS_JSON=

# Cron bảo vệ endpoint /api/broadcast/cron
CRON_SECRET=

# BigQuery / dataset
NEXT_PUBLIC_BQ_PROJECT=levelup-465304
NEXT_PUBLIC_DATASET=STRAMARK_Dataset
