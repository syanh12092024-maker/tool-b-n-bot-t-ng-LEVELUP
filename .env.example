# ─── Secrets (KHÔNG commit file .env thật) ───────────────────────────────────
# Copy file này → .env.local rồi điền giá trị thật.
# Code đọc env này và ưu tiên ghi đè lên giá trị trong config/script-generator.yaml.

# Facebook Graph API
FB_USER_ACCESS_TOKEN=
FB_APP_SECRET=

# Pancake CRM
PANCAKE_CRM_TOKEN=

# Google Cloud credentials (chọn 1 trong các cách)
# GOOGLE_CREDENTIALS_BASE64=
# GOOGLE_CREDENTIALS_JSON=

# Cron bảo vệ endpoint /api/broadcast/cron
# (cron-runner.mjs tự đọc .env.local và gửi kèm — đặt là an toàn)
CRON_SECRET=

# 🔒 BẢO VỆ TOÀN BỘ API (/api/broadcast, /api/broadcast/schedule)
# Bắt buộc đặt khi deploy ra IP public! UI sẽ hỏi mã này 1 lần và lưu trong trình duyệt.
APP_ACCESS_KEY=

# URL public của server ảnh (bật fallback gửi ảnh qua content_url). Để trống nếu không có.
# PUBLIC_URL=

# URL app dùng cho cron self-call (mặc định http://localhost:3001)
# NEXT_PUBLIC_APP_URL=
# CRON_URL=
# CRON_INTERVAL_MS=

# BigQuery / dataset
NEXT_PUBLIC_BQ_PROJECT=levelup-465304
NEXT_PUBLIC_DATASET=STRAMARK_Dataset
