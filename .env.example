# ╔════════════════════════════════════════════════════════════════════╗
# ║  Bắn bot TALPHA v2 — copy file này thành .env rồi điền giá trị     ║
# ║  .env đã nằm trong .gitignore — KHÔNG commit lên git               ║
# ╚════════════════════════════════════════════════════════════════════╝

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://banbot:banbot@localhost:5432/banbot

# ─── Pancake ─────────────────────────────────────────────────────────
# Token CRM lấy từ tài khoản Pancake (JWT). Đây là token BẮT BUỘC.
PANCAKE_CRM_TOKEN=
PANCAKE_API_URL=https://pages.fm/api/v1
PANCAKE_PUBLIC_API_URL=https://pages.fm/api/public_api/v1

# ─── Facebook (đường gửi dự phòng) ───────────────────────────────────
FB_USER_ACCESS_TOKEN=
FB_APP_SECRET=
FB_GRAPH_VERSION=v21.0

# ─── Hành trình khách ────────────────────────────────────────────────
# 7 ngày × 4 khung giờ = 28 lượt, xoay vòng trên 12 nội dung
JOURNEY_DAYS=7
SLOTS_PER_DAY=4
MESSAGE_COUNT=12
SEND_SLOT_HOURS=6,11,17,21

# Cửa sổ Facebook cho phép chủ động nhắn (HUMAN_AGENT) — ngày
SEND_WINDOW_DAYS=7

# Khách trả lời tin thì có dừng chuỗi không?
# false = vẫn gửi tiếp (lựa chọn hiện tại). true = dừng ngay khi khách nhắn lại.
STOP_ON_REPLY=false

# ─── Nhịp gửi ────────────────────────────────────────────────────────
SEND_BATCH_SIZE=8
SEND_BATCH_DELAY_MS=2500
# Job trễ quá số phút này so với giờ hẹn thì bỏ, không gửi bù
SEND_LATE_WINDOW_MIN=60
SEND_MAX_ATTEMPTS=3

# ─── Giám sát sức khoẻ page ──────────────────────────────────────────
# Tỉ lệ lỗi vượt ngưỡng này (0.30 = 30%) → hãm tốc
HEALTH_DEGRADE_ERROR_RATE=0.30
HEALTH_DEGRADE_BATCH_SIZE=4
HEALTH_DEGRADE_DELAY_MS=10000
# Số phút tạm ngưng page khi gặp #2022 hoặc lỗi 121
HEALTH_PAUSE_MINUTES=30
# Bị ngưng bấy nhiêu lần trong 24h → ngưng dài
HEALTH_ESCALATE_AFTER_PAUSES=3
HEALTH_ESCALATE_HOURS=6
# Số tin tối thiểu trong cửa sổ trước khi tin vào tỉ lệ lỗi
HEALTH_MIN_SAMPLE=20

# ─── Khởi động dần cho page mới ──────────────────────────────────────
# Ngày 1 gửi 25% tệp, tăng dần tới 100%
RAMP_UP_DAYS=3
RAMP_UP_START_PERCENT=25

# ─── Đồng bộ tệp khách ───────────────────────────────────────────────
# Giờ địa phương của page mà job SYNC chạy
SYNC_HOUR_LOCAL=3
# Quét lùi tối đa bao nhiêu cửa sổ 28 ngày (36 ≈ 3 năm)
SYNC_MAX_WINDOWS=36
SYNC_MAX_CUSTOMERS_PER_PAGE=20000
SYNC_PAGE_CONCURRENCY=4

# ─── Pancake POS (đối chiếu đơn tự động) ─────────────────────────────
# Khoá từng shop để ở config/pos-shops.json (chép từ pos-shops.example.json).
# Không có file đó → job POS tự tắt, vẫn bắt đơn qua webhook + tag mua hàng.
POS_API_URL=https://pos.pages.fm/api/v1

# POS đếm đơn TRỌN ĐỜI, nên "có đơn" ≠ "vừa chốt trong chuỗi này".
#   increase (mặc định) — ghi mốc lúc khách vào chuỗi, chỉ dừng khi số đơn VƯỢT mốc.
#                         Người mua 6 tháng trước mà nay nhắn lại vẫn được nuôi dưỡng.
#   any                 — dừng với bất kỳ ai đã từng có đơn.
POS_CONVERT_MODE=increase

# ─── Webhook ─────────────────────────────────────────────────────────
WEBHOOK_PORT=8080
WEBHOOK_SECRET=

# ─── Khác ────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
